      "script": "LittlerootTown_EventScript_FatMan",
      "easterEggTheme": "PC storage, logs, backups, debugging",
      "firstInteraction": {
        "messages": [
          {
            "pages": [
              [
                "This PC stores items and data.",
                "The power of science!"
              ],
              [
                "A builder named Uttkarsh says",
                "good logs help catch bugs."
              ],
              [
                "I thought logs were fallen trees.",
                "Computers are very strange!"
              ]
            ]
          }
        ]
      },
      "repeatInteraction": {
        "messages": [
          {
            "pages": [
              [
                "Remember to back up your work.",
                "Even genius needs a backup."
              ]
            ]
          }
        ]
      }
    },
    {
      "id": "littleroot-boy-2",
      "name": "Boy 2",
      "map": "LittlerootTown",
      "objectEventId": 3,
      "graphicsId": "OBJ_EVENT_GFX_BOY_2",
      "script": "LittlerootTown_EventScript_Boy",
      "easterEggTheme": "reproduce bugs, inspect logs, iterate",
      "firstInteraction": {
        "messages": [
          {
            "pages": [
              [
                "PROF. BIRCH studies here,",
                "then tests ideas in the wild."
              ],
              [
                "I hear Uttkarsh hunts bugs",
                "the same way: reproduce them,"
              ],
              [
                "read the logs, try again.",
                "That's real field research!"
              ]
            ]
          }
        ]
      },
      "repeatInteraction": {
        "messages": [
          {
            "pages": [
              [
                "A bug that won't reproduce",
                "is a very sneaky Pokémon."
              ]
            ]
          }
        ]
      }
    },
