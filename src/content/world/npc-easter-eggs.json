    {
      "id": "mays-house-rival-mom",
      "name": "Rival's Mom",
      "map": "LittlerootTown_MaysHouse_1F",
      "objectEventId": 4,
      "graphicsId": "OBJ_EVENT_GFX_WOMAN_4",
      "script": "RivalsHouse_1F_EventScript_RivalMom",
      "easterEggTheme": "backend services, integrations, Acko Clinic",
      "firstInteraction": {
        "messages": [
          {
            "pages": [
              [
                "My husband studies Pokémon",
                "out in the field."
              ],
              [
                "A young engineer named Uttkarsh",
                "builds services that work together."
              ],
              [
                "He calls one project Acko Clinic.",
                "Sounds like a place for Pokémon!"
              ]
            ]
          }
        ]
      },
      "repeatInteraction": {
        "messages": [
          {
            "pages": [
              [
                "One service may look healthy,",
                "while its neighbour is in trouble."
              ],
              [
                "You have to check the whole",
                "journey, not just one step."
              ]
            ]
          }
        ]
      }
    },
    {
      "id": "mays-house-rival-sibling",
      "name": "Rival's Sibling",
      "map": "LittlerootTown_MaysHouse_1F",
      "objectEventId": 6,
      "graphicsId": "OBJ_EVENT_GFX_NINJA_BOY",
      "script": "RivalsHouse_1F_EventScript_RivalSibling",
      "easterEggTheme": "chess and thinking ahead",
      "firstInteraction": {
        "messages": [
          {
            "pages": [
              [
                "Hey, neighbor!",
                "I heard you play chess."
              ],
              [
                "I tried planning three moves ahead…",
                "then forgot the first one!"
              ]
            ]
          }
        ]
      },
      "repeatInteraction": {
        "messages": [
          {
            "pages": [
              [
                "Practice beats a perfect plan.",
                "Even in chess. Probably."
              ]
            ]
          }
        ]
      }
    },
    {
      "id": "birchs-lab-aide",
      "name": "Birch's Aide",
      "map": "LittlerootTown_ProfessorBirchsLab",
      "objectEventId": 1,
      "graphicsId": "OBJ_EVENT_GFX_SCIENTIST_1",
      "script": "LittlerootTown_ProfessorBirchsLab_EventScript_Aide",
      "easterEggTheme": "observability: logs, metrics, traces",
      "firstInteraction": {
        "messages": [
          {
            "pages": [
              [
                "We track Pokémon habitats,",
                "numbers, and changes over time."
              ],
              [
                "Uttkarsh calls it observability:",
                "logs, metrics, and traces…"
              ],
              [
                "so a problem can't hide",
                "forever in the tall grass."
              ]
            ]
          }
        ]
      },
      "repeatInteraction": {
        "messages": [
          {
            "pages": [
              [
                "If an experiment fails,",
                "record what happened."
              ],
              [
                "That's how the next one",
                "gets a little better."
              ]
            ]
          }
        ]
      }
    },
    {
      "id": "birchs-lab-professor-birch",
      "name": "Professor Birch",
      "map": "LittlerootTown_ProfessorBirchsLab",
      "objectEventId": 2,
      "graphicsId": "OBJ_EVENT_GFX_PROF_BIRCH",
      "script": "LittlerootTown_ProfessorBirchsLab_EventScript_Birch",
      "easterEggTheme": "scientific method and breadth of projects",
      "firstInteraction": {
        "messages": [
          {
            "pages": [
              [
                "Good science begins with a",
                "question, not an assumption."
              ],
              [
                "Observe. Form a hypothesis.",
                "Test it in the field."
              ],
              [
                "Then follow the evidence.",
                "Never let a guess win!"
              ],
              [
                "I've heard Uttkarsh builds",
                "projects across many fields…"
              ],
              [
                "each one teaches him",
                "how the pieces fit together."
              ]
            ]
          }
        ]
      },
      "repeatInteraction": {
        "messages": [
          {
            "pages": [
              [
                "Curiosity starts the journey.",
                "Evidence tells you where to go."
              ],
              [
                "That works for software",
                "as well as Pokémon, I suspect."
              ]
            ]
          }
        ]
      }
    }
  ]
