      "firstInteraction": {
        "messages": [
          {
            "pages": [
              [
                "You saved PROF. BIRCH!",
                "I'm so glad!"
              ],
              [
                "They say you collect projects",
                "from all sorts of fields."
              ],
              [
                "Not Pokémon, not badges—",
                "just one idea after another!"
              ]
            ]
          }
        ]
      },
      "repeatInteraction": {
        "messages": [
          {
            "pages": [
              [
                "Still chasing new ideas?",
                "Try finishing one, too!"
              ]
            ]
          }
        ]
      }
