{
  "name": "tmp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . && depcruise src",
    "typecheck": "tsc --noEmit",
    "check:deps": "depcruise src",
    "compile:maps": "tsx scripts/compile-maps.ts",
